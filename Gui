-- ==================== DEFAULT Z-GUI ANIMATION ====================
local DEFAULT_ANIMATIONS = {
    idle = "rbxassetid://110939321724226",
    walk = "rbxassetid://102031415992902",
    run = "rbxassetid://105492432746214",
    jump = "rbxassetid://123814879688543",
    fall = "rbxassetid://132358096834201",
    climb = "rbxassetid://74422682039842"
}

local DEFAULT_RUN_THRESHOLD = 16

local defaultTracks = {}
local defaultConnections = {}
local defaultHumanoid
local defaultCharacter

local function stopDefaultAnimations()
    for _, track in pairs(defaultTracks) do
        if track and track.IsPlaying then
            pcall(function()
                track:Stop(0.12)
            end)
        end
    end
end

local function cleanupDefaultAnimations()
    for _, connection in pairs(defaultConnections) do
        if connection then
            connection:Disconnect()
        end
    end

    table.clear(defaultConnections)

    stopDefaultAnimations()

    for _, track in pairs(defaultTracks) do
        if track then
            pcall(function()
                track:Destroy()
            end)
        end
    end

    table.clear(defaultTracks)
end

local function defaultAnimationBlocked(humanoid)
    if not humanoid or humanoid.Health <= 0 then
        return true
    end

    if AnimationState.Controller == "TallV2"
        or AnimationState.FlyActive
        or AnimationState.CrouchActive
        or humanoid.PlatformStand then
        return true
    end

    local state = humanoid:GetState()

    return state == Enum.HumanoidStateType.Seated
        or state == Enum.HumanoidStateType.PlatformStanding
        or state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.Dead
        or state == Enum.HumanoidStateType.Swimming
end

local function playDefaultAnimation(name)
    local selected = defaultTracks[name]

    if not selected or not defaultHumanoid then
        return
    end

    if defaultAnimationBlocked(defaultHumanoid) then
        stopDefaultAnimations()
        return
    end

    for otherName, track in pairs(defaultTracks) do
        if otherName ~= name and track and track.IsPlaying then
            track:Stop(0.12)
        end
    end

    if not selected.IsPlaying then
        selected:Play(0.12)
    end
end

local function updateDefaultMovement(speed)
    local humanoid = defaultHumanoid

    if defaultAnimationBlocked(humanoid) then
        stopDefaultAnimations()
        return
    end

    if speed <= 0.5 then
        playDefaultAnimation("idle")
    elseif speed <= DEFAULT_RUN_THRESHOLD then
        playDefaultAnimation("walk")
    else
        playDefaultAnimation("run")
    end
end

local function loadDefaultTrack(animator, name, id, priority, looped)
    local animation = Instance.new("Animation")
    animation.AnimationId = id

    local success, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    animation:Destroy()

    if not success or not track then
        warn("[Z-GUI Animation] Cannot load:", name)
        return nil
    end

    track.Priority = priority
    track.Looped = looped

    return track
end

local function applyDefaultAnimations(character)
    cleanupDefaultAnimations()

    defaultCharacter = character

    local humanoid = character:WaitForChild("Humanoid")

    if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        warn("[Z-GUI Animation] R15 only.")
        return
    end

    local animator = humanoid:WaitForChild("Animator")
    defaultHumanoid = humanoid

    defaultTracks.idle = loadDefaultTrack(
        animator, "idle", DEFAULT_ANIMATIONS.idle,
        Enum.AnimationPriority.Movement, true
    )

    defaultTracks.walk = loadDefaultTrack(
        animator, "walk", DEFAULT_ANIMATIONS.walk,
        Enum.AnimationPriority.Movement, true
    )

    defaultTracks.run = loadDefaultTrack(
        animator, "run", DEFAULT_ANIMATIONS.run,
        Enum.AnimationPriority.Movement, true
    )

    defaultTracks.jump = loadDefaultTrack(
        animator, "jump", DEFAULT_ANIMATIONS.jump,
        Enum.AnimationPriority.Action, false
    )

    defaultTracks.fall = loadDefaultTrack(
        animator, "fall", DEFAULT_ANIMATIONS.fall,
        Enum.AnimationPriority.Movement, true
    )

    defaultTracks.climb = loadDefaultTrack(
        animator, "climb", DEFAULT_ANIMATIONS.climb,
        Enum.AnimationPriority.Movement, true
    )

    defaultConnections.running = humanoid.Running:Connect(
        updateDefaultMovement
    )

    defaultConnections.state = humanoid.StateChanged:Connect(function(_, newState)
        if defaultAnimationBlocked(humanoid) then
            stopDefaultAnimations()
            return
        end

        if newState == Enum.HumanoidStateType.Jumping then
            playDefaultAnimation("jump")

        elseif newState == Enum.HumanoidStateType.Freefall then
            playDefaultAnimation("fall")

        elseif newState == Enum.HumanoidStateType.Climbing then
            playDefaultAnimation("climb")

        else
            task.defer(function()
                if defaultHumanoid ~= humanoid or not humanoid.Parent then
                    return
                end

                local root = character:FindFirstChild("HumanoidRootPart")
                local speed = 0

                if root then
                    local velocity = root.AssemblyLinearVelocity
                    speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
                end

                updateDefaultMovement(speed)
            end)
        end
    end)

    defaultConnections.platformStand =
        humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
            if humanoid.PlatformStand then
                stopDefaultAnimations()
            else
                task.defer(function()
                    if defaultHumanoid == humanoid then
                        updateDefaultMovement(humanoid.MoveDirection.Magnitude * humanoid.WalkSpeed)
                    end
                end)
            end
        end)

    defaultConnections.sharedState = RunService.Heartbeat:Connect(function()
        if defaultHumanoid ~= humanoid then
            return
        end

        if defaultAnimationBlocked(humanoid) then
            stopDefaultAnimations()
        end
    end)

    updateDefaultMovement(0)
end


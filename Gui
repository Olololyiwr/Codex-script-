    if not tallEnabled then return end

    character = character or LocalPlayer.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
        or character:WaitForChild("Humanoid", 10)

    if not humanoid or humanoid.Health <= 0 then return end

    if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        warn("[Z-GUI] Tall v2 yêu cầu nhân vật R15.")
        return
    end

    if AnimationControl.Owner and AnimationControl.Owner ~= "Tall" then
        warn("[Z-GUI] Hãy tắt Fly/Crouch trước khi bật Tall v2.")
        return
    end

    if tallConnection then
        tallConnection:Disconnect()
        tallConnection = nil
    end

    stopTrackSet(tallTracks)
    table.clear(tallTracks)

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    local loadedTracks = {}

    local success, result = pcall(function()
        loadedTracks.Idle = loadAnimationTrack(
            animator,
            TALL_ANIMATIONS.Idle,
            Enum.AnimationPriority.Action4,
            true
        )

        loadedTracks.Walk = loadAnimationTrack(
            animator,
            TALL_ANIMATIONS.Walk,
            Enum.AnimationPriority.Action4,
            true
        )

        loadedTracks.Run = loadAnimationTrack(
            animator,
            TALL_ANIMATIONS.Run,
            Enum.AnimationPriority.Action4,
            true
        )

        loadedTracks.Jump = loadAnimationTrack(
            animator,
            TALL_ANIMATIONS.Jump,
            Enum.AnimationPriority.Action4,
            false
        )

        loadedTracks.Fall = loadAnimationTrack(
            animator,
            TALL_ANIMATIONS.Fall,
            Enum.AnimationPriority.Action4,
            true
        )

        loadedTracks.Climb = loadAnimationTrack(
            animator,
            TALL_ANIMATIONS.Climb,
            Enum.AnimationPriority.Action4,
            true
        )

        return loadedTracks
    end)

    if not success or not result then
        stopTrackSet(loadedTracks)
        warn("[Z-GUI] Không thể tải đầy đủ Tall v2 animation.")
        return
    end

    tallTracks = result
    AnimationControl.Tracks = tallTracks
    setAnimationOwner("Tall")

    tallHumanoid = humanoid
    tallCharacter = character

    tallOriginalWalkSpeed = humanoid.WalkSpeed
    tallOriginalJumpPower = humanoid.JumpPower
    tallOriginalJumpHeight = humanoid.JumpHeight

    humanoid.WalkSpeed = tallWalkSpeed
    humanoid.UseJumpPower = true
    humanoid.JumpPower = tallJumpPower
    humanoid.JumpHeight = tallJumpHeight

    local function playTallAnimation(name, speed)
        local selected = tallTracks[name]
        if not selected then return end

        for trackName, track in pairs(tallTracks) do
            if trackName ~= name and track.IsPlaying then
                track:Stop(0.12)
            end
        end

        if not selected.IsPlaying then
            selected:Play(0.12)
        end

        if speed then
            selected:AdjustSpeed(speed)
        end
    end

    local lastState = nil

    tallConnection = RunService.Heartbeat:Connect(function()
        if not tallEnabled
            or tallCharacter ~= character
            or not character.Parent
            or humanoid.Health <= 0 then
            return
        end

        humanoid.WalkSpeed = tallWalkSpeed
        humanoid.UseJumpPower = true
        humanoid.JumpPower = tallJumpPower
        humanoid.JumpHeight = tallJumpHeight

        local state = humanoid:GetState()
        local animationName

        if state == Enum.HumanoidStateType.Jumping then
            animationName = "Jump"

        elseif state == Enum.HumanoidStateType.Freefall then
            animationName = "Fall"

        elseif state == Enum.HumanoidStateType.Climbing then
            animationName = "Climb"

        elseif state == Enum.HumanoidStateType.Swimming
            or state == Enum.HumanoidStateType.Seated
            or state == Enum.HumanoidStateType.Dead then

            stopTrackSet(tallTracks)
            lastState = nil
            return
        else
            local moving = humanoid.MoveDirection.Magnitude > 0.05

            if not moving then
                animationName = "Idle"
            elseif humanoid.WalkSpeed >= tallRunThreshold then
                animationName = "Run"
            else
                animationName = "Walk"
            end
        end

        if animationName then
            local speed = 1

            if animationName == "Run" then
                speed = math.max(1, humanoid.WalkSpeed / 16)
            elseif animationName == "Walk" then
                speed = math.max(0.5, humanoid.WalkSpeed / 16)
            end

            if animationName ~= lastState
                or not tallTracks[animationName].IsPlaying then
                playTallAnimation(animationName, speed)
                lastState = animationName
            end
        end
    end)

    playTallAnimation("Idle")
end

local function disableTall()
    tallEnabled = false

    stopTallController()

    local character = LocalPlayer.Character

    if character then
        task.defer(function()
            if not AnimationControl.Owner then
                setupBaseController(character)
            end
        end)
    end
end

makeToggle(Tab3C, "📏 Tall v2", 4, function(state)
    if state then
        if AnimationControl.Owner then
            warn("[Z-GUI] Hãy tắt chế độ animation đang hoạt động trước.")
            return
        end

        tallEnabled = true
        startTallController(LocalPlayer.Character)

        if not tallHumanoid then
            tallEnabled = false
        end
    else
        disableTall()
    end
end)

LocalPlayer.CharacterAdded:Connect(function(character)
    if not tallEnabled then return end

    if tallConnection then
        tallConnection:Disconnect()
        tallConnection = nil
    end

    stopTrackSet(tallTracks)
    table.clear(tallTracks)

    tallHumanoid = nil
    tallCharacter = nil

    task.wait(0.7)

    if tallEnabled then
        startTallController(character)
    end
end)


local espActive = false
local espConn

local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if espActive and character and root and humanoid and humanoid.Health > 0 then
                local espGui = character:FindFirstChild("ZGuiESP")

                if not espGui then
                    espGui = Instance.new("BillboardGui", character)
                    espGui.Name = "ZGuiESP"
                    espGui.Size = UDim2.new(0, 120, 0, 50)
                    espGui.StudsOffset = Vector3.new(0, 3.5, 0)
                    espGui.AlwaysOnTop = true

                    local nameLabel = Instance.new("TextLabel", espGui)
                    nameLabel.Name = "NameLabel"
                    nameLabel.Size = UDim2.new(1, 0, 0, 22)
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Font = Enum.Font.GothamBold
                    nameLabel.TextSize = 12
                    nameLabel.TextStrokeTransparency = 0.5

                    local hpBackground = Instance.new("Frame", espGui)
                    hpBackground.Name = "HpBg"
                    hpBackground.Size = UDim2.new(0.8, 0, 0, 5)
                    hpBackground.Position = UDim2.new(0.1, 0, 0, 24)
                    hpBackground.BackgroundColor3 = Color3.fromRGB(40, 100, 40)
                    hpBackground.BorderSizePixel = 0

                    Instance.new("UICorner", hpBackground).CornerRadius =
                        UDim.new(1, 0)

                    local hpBar = Instance.new("Frame", hpBackground)
                    hpBar.Name = "HpBar"
                    hpBar.Size = UDim2.new(1, 0, 1, 0)
                    hpBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                    hpBar.BorderSizePixel = 0

                    Instance.new("UICorner", hpBar).CornerRadius =
                        UDim.new(1, 0)

                    local highlight = Instance.new("Highlight", character)
                    highlight.Name = "ZGuiHighlight"
                    highlight.FillTransparency = 0.5
                end

                local roleColor = Color3.fromRGB(0, 255, 100)
                local backpack = player:FindFirstChild("Backpack")
                local hasWeapon = false

                pcall(function()
                    local tool = character:FindFirstChildOfClass("Tool")

                    if (tool and (
                        tool.Name:lower():find("knife")
                        or tool.Name:lower():find("gun")
                        or tool.Name:lower():find("sword")
                        or tool.Name:lower():find("revolver")
                    )) or (
                        backpack and (
                            backpack:FindFirstChild("Knife")
                            or backpack:FindFirstChild("Revolver")
                            or backpack:FindFirstChild("Gun")
                            or backpack:FindFirstChild("Sword")
                        )
                    ) then
                        hasWeapon = true
                    end
                end)

                if hasWeapon then
                    roleColor = Color3.fromRGB(255, 50, 50)
                elseif player.Team then
                    local teamName = player.Team.Name:lower()

                    if teamName:find("murder")
                        or teamName:find("killer")
                        or teamName:find("zombie")
                        or teamName:find("bad") then
                        roleColor = Color3.fromRGB(255, 50, 50)
                    end
                end

                local nameLabel = espGui:FindFirstChild("NameLabel")
                local hpBar = espGui:FindFirstChild("HpBg")
                    and espGui.HpBg:FindFirstChild("HpBar")
                local highlight = character:FindFirstChild("ZGuiHighlight")

                if nameLabel then
                    nameLabel.Text = player.Name
                    nameLabel.TextColor3 = roleColor
                end

                if hpBar then
                    hpBar.Size = UDim2.new(
                        math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1),
                        0, 1, 0
                    )
                end

                if highlight then
                    highlight.FillColor = roleColor
                    highlight.OutlineColor = roleColor
                end
            else
                if character and character:FindFirstChild("ZGuiESP") then
                    character.ZGuiESP:Destroy()
                end

                if character and character:FindFirstChild("ZGuiHighlight") then
                    character.ZGuiHighlight:Destroy()
                end
            end
        end
    end
end


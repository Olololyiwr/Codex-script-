local function stopTrack(track, fadeTime)
    if track then
        pcall(function()
            track:Stop(fadeTime or 0.12)
        end)
    end
end

local function stopTrackSet(trackSet)
    for _, track in pairs(trackSet or {}) do
        stopTrack(track)
    end
end

local function stopBaseAnimations()
    stopTrackSet(AnimationControl.BaseTracks)
end

local function stopCustomAnimations()
    stopTrackSet(AnimationControl.Tracks)
end

local function stopAllAnimatorTracks(animator)
    if not animator then return end

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        pcall(function()
            track:Stop(0.1)
        end)
    end
end

local function loadAnimationTrack(animator, animationId, priority, looped)
    local animation = Instance.new("Animation")
    animation.AnimationId = animationId

    local track = animator:LoadAnimation(animation)
    track.Priority = priority
    track.Looped = looped == true

    animation:Destroy()
    return track
end

local function clearBaseController()
    for _, connection in ipairs(AnimationControl.BaseConnections) do
        connection:Disconnect()
    end

    table.clear(AnimationControl.BaseConnections)
    stopTrackSet(AnimationControl.BaseTracks)
    table.clear(AnimationControl.BaseTracks)
end

local function playBaseAnimation(name, speed)
    if not AnimationControl.Enabled or AnimationControl.Owner then
        return
    end

    local tracks = AnimationControl.BaseTracks
    local selected = tracks[name]

    if not selected then return end

    for trackName, track in pairs(tracks) do
        if trackName ~= name and track.IsPlaying then
            track:Stop(0.12)
        end
    end

    if not selected.IsPlaying then
        selected:Play(0.12)
    end

    if speed then
        selected:AdjustSpeed(speed)
    end
end

local function setupBaseController(character)
    clearBaseController()

    AnimationControl.Character = character
    AnimationControl.Humanoid = nil
    AnimationControl.Animator = nil

    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        return
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
        or humanoid:WaitForChild("Animator", 5)

    if not animator then return end

    AnimationControl.Humanoid = humanoid
    AnimationControl.Animator = animator

    local priorities = {
        Idle = Enum.AnimationPriority.Action2,
        Walk = Enum.AnimationPriority.Action2,
        Run = Enum.AnimationPriority.Action2,
        Jump = Enum.AnimationPriority.Action2,
        Fall = Enum.AnimationPriority.Action2,
        Climb = Enum.AnimationPriority.Action2
    }

    for name, animationId in pairs(DEFAULT_ANIMATIONS) do
        local success, track = pcall(function()
            return loadAnimationTrack(
                animator,
                animationId,
                priorities[name],
                name == "Idle" or name == "Walk" or name == "Run"
                    or name == "Fall" or name == "Climb"
            )
        end)

        if success and track then
            AnimationControl.BaseTracks[name] = track
        else
            warn("[Z-GUI] Không tải được animation mặc định: " .. name)
        end
    end

    -- Giữ Jump trong một khoảng ngắn khi vừa chuyển sang Freefall.
    local jumpHoldUntil = 0
    local JUMP_TRANSITION_HOLD = 0.18

    -- Bắt sự kiện Jumping ngay khi nó xảy ra, không chỉ kiểm tra Heartbeat.
    table.insert(
        AnimationControl.BaseConnections,
        humanoid.StateChanged:Connect(function(_, newState)
            if AnimationControl.Character ~= character
                or AnimationControl.Owner
                or not AnimationControl.Enabled
                or humanoid.Health <= 0 then
                return
            end

            if newState == Enum.HumanoidStateType.Jumping then
                jumpHoldUntil = os.clock() + JUMP_TRANSITION_HOLD
                playBaseAnimation("Jump")
            elseif newState == Enum.HumanoidStateType.Freefall then
                jumpHoldUntil = math.max(
                    jumpHoldUntil,
                    os.clock() + JUMP_TRANSITION_HOLD
                )
            end
        end)
    )

    local function update()
        if AnimationControl.Character ~= character
            or AnimationControl.Owner
            or not AnimationControl.Enabled
            or humanoid.Health <= 0 then
            stopBaseAnimations()
            return
        end

        local state = humanoid:GetState()

        if state == Enum.HumanoidStateType.Jumping then
            jumpHoldUntil = os.clock() + JUMP_TRANSITION_HOLD
            playBaseAnimation("Jump")

        elseif state == Enum.HumanoidStateType.Freefall then
            if os.clock() < jumpHoldUntil then
                playBaseAnimation("Jump")
            else
                playBaseAnimation("Fall")
            end

        elseif state == Enum.HumanoidStateType.Climbing then
            playBaseAnimation("Climb")

        elseif state == Enum.HumanoidStateType.Swimming
            or state == Enum.HumanoidStateType.Seated
            or state == Enum.HumanoidStateType.Dead then
            stopBaseAnimations()

        else
            local moving = humanoid.MoveDirection.Magnitude > 0.05

            if moving then
                if humanoid.WalkSpeed >= 35 then
                    playBaseAnimation("Run", humanoid.WalkSpeed / 16)
                else
                    playBaseAnimation("Walk", math.max(0.5, humanoid.WalkSpeed / 16))
                end
            else
                playBaseAnimation("Idle")
            end
        end
    end

    table.insert(
        AnimationControl.BaseConnections,
        RunService.Heartbeat:Connect(update)
    )

    update()
end

local function setAnimationOwner(owner)
    AnimationControl.Owner = owner

    if owner then
        stopBaseAnimations()
    end
end


    end
end)

-- 2. FLY MODE
local IDLE_ANIM_ID = "rbxassetid://77529400769588"
local MOVE_ANIM_ID = "rbxassetid://132105268936736"

local flySpeed = 80
local isFlying = false
local flyConnection = nil
local flyBodyVel, flyBodyGyro = nil, nil
local idleTrack, moveTrack = nil, nil

local function cleanupFly()
    isFlying = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if flyBodyVel then
        flyBodyVel:Destroy()
        flyBodyVel = nil
    end

    if flyBodyGyro then
        flyBodyGyro:Destroy()
        flyBodyGyro = nil
    end

    stopTrack(idleTrack)
    stopTrack(moveTrack)
    idleTrack, moveTrack = nil, nil

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.PlatformStand = false
    end

    if AnimationControl.Owner == "Fly" then
        AnimationControl.Tracks = {}
        setAnimationOwner(nil)
    end
end

makeToggle(Tab1C, "🐦 Fly Mode", 2, function(state)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not state then
        cleanupFly()
        return
    end

    if not character or not root or not humanoid then
        cleanupFly()
        return
    end

    if AnimationControl.Owner and AnimationControl.Owner ~= "Fly" then
        warn("[Z-GUI] Hãy tắt chế độ animation khác trước khi bật Fly.")
        return
    end

    cleanupFly()
    isFlying = true
    setAnimationOwner("Fly")

    local camera = Workspace.CurrentCamera
    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    local success, tracks = pcall(function()
        return {
            Idle = loadAnimationTrack(
                animator,
                IDLE_ANIM_ID,
                Enum.AnimationPriority.Action4,
                true
            ),
            Move = loadAnimationTrack(
                animator,
                MOVE_ANIM_ID,
                Enum.AnimationPriority.Action4,
                true
            )
        }
    end)

    if not success or not tracks then
        cleanupFly()
        warn("[Z-GUI] Không tải được Fly animation.")
        return
    end

    idleTrack = tracks.Idle
    moveTrack = tracks.Move
    AnimationControl.Tracks = tracks

    flyBodyVel = Instance.new("BodyVelocity")
    flyBodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBodyVel.Velocity = Vector3.zero
    flyBodyVel.Parent = root

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyBodyGyro.P = 10000
    flyBodyGyro.CFrame = camera.CFrame
    flyBodyGyro.Parent = root

    humanoid.PlatformStand = true
    idleTrack:Play(0.12)

    flyConnection = RunService.RenderStepped:Connect(function()
        if not isFlying or not root.Parent or humanoid.Health <= 0 then
            cleanupFly()
            return
        end

        local moveVector = Vector3.zero

        pcall(function()
            local controls = require(
                LocalPlayer.PlayerScripts.PlayerModule
            ):GetControls()

            moveVector = controls:GetMoveVector()
        end)

        if moveVector.Magnitude > 0.01 then
            if not moveTrack.IsPlaying then
                stopTrack(idleTrack)
                moveTrack:Play(0.12)
            end

            local cameraCFrame = camera.CFrame
            local flyDirection =
                (cameraCFrame.RightVector * moveVector.X)
                + (cameraCFrame.LookVector * -moveVector.Z)

            flyBodyVel.Velocity = flyDirection * flySpeed
            flyBodyGyro.CFrame = CFrame.lookAt(
                root.Position,
                root.Position + flyDirection
            )
        else
            if not idleTrack.IsPlaying then
                stopTrack(moveTrack)

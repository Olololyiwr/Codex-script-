-- 1. GOD MODE
local godModeEnabled = false
local godHealthConnection = nil
local godCharacterConnection = nil
local godDisabledScripts = {}

local function disconnectGodHealth()
    if godHealthConnection then
        godHealthConnection:Disconnect()
        godHealthConnection = nil
    end
end

local function restoreGodScripts()
    for scriptObject, previousState in pairs(godDisabledScripts) do
        pcall(function()
            if scriptObject and scriptObject.Parent then
                scriptObject.Disabled = previousState
            end
        end)
    end

    table.clear(godDisabledScripts)
end

local function disableGodDamageScripts(character)
    if not character then return end

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Script") or child:IsA("LocalScript") then
            local scriptName = child.Name:lower()

            if scriptName == "falldamage"
                or scriptName == "ragdoll"
                or scriptName:find("damage") then

                if godDisabledScripts[child] == nil then
                    local success, previousState = pcall(function()
                        return child.Disabled
                    end)

                    if success then
                        godDisabledScripts[child] = previousState

                        pcall(function()
                            child.Disabled = true
                        end)
                    end
                end
            end
        end
    end
end

local function enableGodMode()
    if not godModeEnabled then return end

    disconnectGodHealth()

    local character = LocalPlayer.Character
    if not character then return end

    disableGodDamageScripts(character)

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    godHealthConnection = humanoid.HealthChanged:Connect(function(health)
        if godModeEnabled and health < humanoid.MaxHealth then
            pcall(function()
                humanoid.Health = humanoid.MaxHealth
            end)
        end
    end)

    pcall(function()
        humanoid.Health = humanoid.MaxHealth
    end)
end

local function disableGodMode()
    godModeEnabled = false
    disconnectGodHealth()
    restoreGodScripts()
end

godCharacterConnection = LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)

    if godModeEnabled then
        enableGodMode()
    end
end)

makeToggle(Tab1C, "🛡️ God Mode", 1, function(state)
    godModeEnabled = state

    if state then
        enableGodMode()
    else

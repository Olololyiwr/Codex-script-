local crouchSystemEnabled = false
local crouchGui = nil
local touchControlsFrame = nil
local crouchButton = nil

local crouchButtonImage = "rbxassetid://109660173469064"
local crouchButtonActiveImage = "rbxassetid://139705395031155"

-- Đã đảo ID để khớp chiều animation thực tế.
local crouchWalkAnimId = "rbxassetid://107078800928182"
local crouchIdleAnimId = "rbxassetid://137525751454426"

local isCrouching = false
local defaultWalkSpeed = 16
local defaultJumpPower = 50

local idleAnimIdCache = nil
local walkAnimIdCache = nil

local crouchIdleAnimTrack = nil
local crouchWalkAnimTrack = nil

local crouchAnimSpeed = 0.8
local crouchWalkSpeed = 5

local crouchHeartbeatConn = nil
local crouchInputBeganConn = nil
local crouchJumpReqConn = nil
local crouchInputTypeConn = nil
local crouchCharAddedConn = nil

local crouchHumanoid = nil
local crouchCharacter = nil

local function updateCrouchButtonVisibility()
    if crouchButton then
        crouchButton.Visible =
            crouchSystemEnabled
            and UserInputService:GetLastInputType()
                == Enum.UserInputType.Touch
    end
end

local function cacheCrouchAnimations()
    local character = LocalPlayer.Character
    if not character then return end

    local animate = character:FindFirstChild("Animate")
    if not animate then return end

    if not idleAnimIdCache then
        local idleFolder = animate:FindFirstChild("idle")
        local idleAnimation = idleFolder
            and idleFolder:FindFirstChild("Animation1")

        if idleAnimation then
            idleAnimIdCache = idleAnimation.AnimationId
        end
    end

    if not walkAnimIdCache then
        local walkFolder = animate:FindFirstChild("walk")
        local walkAnimation = walkFolder
            and walkFolder:FindFirstChild("WalkAnim")

        if walkAnimation then
            walkAnimIdCache = walkAnimation.AnimationId
        end
    end
end

local function restoreCrouchAnimateIds(character)
    character = character or LocalPlayer.Character
    if not character then return end

    local animate = character:FindFirstChild("Animate")
    if not animate then return end

    if idleAnimIdCache then
        local idleFolder = animate:FindFirstChild("idle")
        local idleAnimation = idleFolder
            and idleFolder:FindFirstChild("Animation1")

        if idleAnimation then
            idleAnimation.AnimationId = idleAnimIdCache
        end
    end

    if walkAnimIdCache then
        local walkFolder = animate:FindFirstChild("walk")
        local walkAnimation = walkFolder
            and walkFolder:FindFirstChild("WalkAnim")

        if walkAnimation then
            walkAnimation.AnimationId = walkAnimIdCache
        end
    end
end

local function stopCrouchTracks()
    stopTrack(crouchIdleAnimTrack)
    stopTrack(crouchWalkAnimTrack)

    crouchIdleAnimTrack = nil
    crouchWalkAnimTrack = nil
end

local function deactivateCrouchState()
    if not isCrouching then return end

    isCrouching = false

    if crouchHeartbeatConn then
        crouchHeartbeatConn:Disconnect()
        crouchHeartbeatConn = nil
    end

    stopCrouchTracks()

    if crouchButton then
        crouchButton.Image = crouchButtonImage
    end

    local humanoid = crouchHumanoid

    if humanoid and humanoid.Parent then
        humanoid.WalkSpeed = defaultWalkSpeed
        humanoid.JumpPower = defaultJumpPower
    end

    restoreCrouchAnimateIds(crouchCharacter)

    local jumpButton = PlayerGui:FindFirstChild("JumpButton", true)
    if jumpButton then
        jumpButton.Visible = true
    end

    if AnimationControl.Owner == "Crouch" then
        AnimationControl.Tracks = {}
        setAnimationOwner(nil)
    end

    crouchHumanoid = nil
    crouchCharacter = nil
end

local function activateCrouchState()
    if isCrouching then return end

    local character = LocalPlayer.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if not character or not humanoid then return end

    if AnimationControl.Owner then
        warn("[Z-GUI] Hãy tắt Fly/Tall trước khi bật Crouch.")
        return
    end

    if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        warn("[Z-GUI] Crouch animation yêu cầu R15.")
        return
    end

    cacheCrouchAnimations()

    defaultWalkSpeed = humanoid.WalkSpeed
    defaultJumpPower = humanoid.JumpPower

    crouchCharacter = character
    crouchHumanoid = humanoid
    isCrouching = true

    setAnimationOwner("Crouch")

    if crouchButton then
        crouchButton.Image = crouchButtonActiveImage
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    local success, tracks = pcall(function()
        return {
            Idle = loadAnimationTrack(
                animator,
                crouchIdleAnimId,
                Enum.AnimationPriority.Action4,
                true
            ),

            Walk = loadAnimationTrack(
                animator,
                crouchWalkAnimId,
                Enum.AnimationPriority.Action4,
                true
            )
        }
    end)

    if not success or not tracks then
        isCrouching = false
        setAnimationOwner(nil)
        warn("[Z-GUI] Không tải được Crouch animation.")
        return
    end

    crouchIdleAnimTrack = tracks.Idle
    crouchWalkAnimTrack = tracks.Walk

    AnimationControl.Tracks = tracks

    humanoid.JumpPower = 0
    humanoid.WalkSpeed = crouchWalkSpeed

    local function updateCrouchAnimation()
        if not isCrouching
            or not humanoid.Parent
            or humanoid.Health <= 0 then
            return
        end

        humanoid.WalkSpeed = crouchWalkSpeed

        local isMoving = humanoid.MoveDirection.Magnitude > 0.05

        if isMoving then
            if crouchIdleAnimTrack.IsPlaying then
                crouchIdleAnimTrack:Stop(0.12)
            end

            if not crouchWalkAnimTrack.IsPlaying then
                crouchWalkAnimTrack:Play(0.12)
            end

            crouchWalkAnimTrack:AdjustSpeed(crouchAnimSpeed)
        else
            if crouchWalkAnimTrack.IsPlaying then
                crouchWalkAnimTrack:Stop(0.12)
            end

            if not crouchIdleAnimTrack.IsPlaying then
                crouchIdleAnimTrack:Play(0.12)
            end

            crouchIdleAnimTrack:AdjustSpeed(1)
        end

        if humanoid:GetState() == Enum.HumanoidStateType.Jumping then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end

    if crouchHeartbeatConn then
        crouchHeartbeatConn:Disconnect()
    end

    crouchHeartbeatConn = RunService.Heartbeat:Connect(
        updateCrouchAnimation
    )

    updateCrouchAnimation()

    local jumpButton = PlayerGui:FindFirstChild("JumpButton", true)
    if jumpButton then
        jumpButton.Visible = false
    end
end

local function toggleCrouchState()
    if isCrouching then
        deactivateCrouchState()
    else
        activateCrouchState()
    end
end

local function initCrouchGui()
    if crouchGui then
        crouchGui:Destroy()
    end

    crouchGui = Instance.new("ScreenGui")
    crouchGui.Name = "ZGuiCrouchGui"
    crouchGui.ResetOnSpawn = false
    crouchGui.Parent = PlayerGui

    touchControlsFrame = Instance.new("Frame")
    touchControlsFrame.Size = UDim2.new(1, 0, 1, 0)
    touchControlsFrame.BackgroundTransparency = 1
    touchControlsFrame.Parent = crouchGui

    local jumpButton = PlayerGui:FindFirstChild("JumpButton", true)

    if not jumpButton then
        for _, object in ipairs(PlayerGui:GetDescendants()) do
            if object:IsA("ImageButton")
                and (
                    object.Name == "JumpButton"
                    or object.Name:lower():find("jump")
                ) then
                jumpButton = object
                break
            end
        end
    end

    crouchButton = Instance.new("ImageButton")
    crouchButton.Name = "CrouchButton"
    crouchButton.BackgroundTransparency = 1
    crouchButton.Image = crouchButtonImage
    crouchButton.Parent = touchControlsFrame

    if jumpButton then
        crouchButton.Size = jumpButton.Size
        crouchButton.Position = UDim2.new(
            0,
            jumpButton.AbsolutePosition.X
                - jumpButton.AbsoluteSize.X - 10,
            0,
            jumpButton.AbsolutePosition.Y
        )
    else
        crouchButton.Size = UDim2.new(0, 60, 0, 60)
        crouchButton.Position = UDim2.new(0, 30, 1, -150)
    end

    crouchButton.MouseButton1Click:Connect(toggleCrouchState)
    updateCrouchButtonVisibility()
end


local espActive = false
local espConn = nil

local function updateESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if espActive and char and hrp and hum and hum.Health > 0 then
                local espGui = char:FindFirstChild("ZGuiESP")

                if not espGui then
                    espGui = Instance.new("BillboardGui", char)
                    espGui.Name = "ZGuiESP"
                    espGui.Size = UDim2.new(0, 120, 0, 50)
                    espGui.StudsOffset = Vector3.new(0, 3.5, 0)
                    espGui.AlwaysOnTop = true

                    local nameLbl = Instance.new("TextLabel", espGui)
                    nameLbl.Name = "NameLabel"
                    nameLbl.Size = UDim2.new(1, 0, 0, 22)
                    nameLbl.BackgroundTransparency = 1
                    nameLbl.Font = Enum.Font.GothamBold
                    nameLbl.TextSize = 12
                    nameLbl.TextStrokeTransparency = 0.5

                    local hpBarBg = Instance.new("Frame", espGui)
                    hpBarBg.Name = "HpBg"
                    hpBarBg.Size = UDim2.new(0.8, 0, 0, 5)
                    hpBarBg.Position = UDim2.new(0.1, 0, 0, 24)
                    hpBarBg.BackgroundColor3 = Color3.fromRGB(40, 100, 40)
                    hpBarBg.BorderSizePixel = 0
                    Instance.new("UICorner", hpBarBg).CornerRadius = UDim.new(1, 0)

                    local hpBar = Instance.new("Frame", hpBarBg)
                    hpBar.Name = "HpBar"
                    hpBar.Size = UDim2.new(1, 0, 1, 0)
                    hpBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                    hpBar.BorderSizePixel = 0
                    Instance.new("UICorner", hpBar).CornerRadius = UDim.new(1, 0)

                    local highlight = Instance.new("Highlight", char)
                    highlight.Name = "ZGuiHighlight"
                    highlight.FillTransparency = 0.5
                end

                local roleColor = Color3.fromRGB(0, 255, 100)
                local backpack = p:FindFirstChild("Backpack")
                local hasWeapon = false

                pcall(function()
                    local tool = char:FindFirstChildOfClass("Tool")

                    if (tool and (
                        tool.Name:lower():find("knife")
                        or tool.Name:lower():find("gun")
                        or tool.Name:lower():find("sword")
                        or tool.Name:lower():find("revolver")
                    )) or (
                        backpack and (
                            backpack:FindFirstChild("Knife")
                            or backpack:FindFirstChild("Revolver")
                            or backpack:FindFirstChild("Gun")
                            or backpack:FindFirstChild("Sword")
                        )
                    ) then
                        hasWeapon = true
                    end
                end)

                if hasWeapon then
                    roleColor = Color3.fromRGB(255, 50, 50)
                elseif p.Team then
                    local tn = p.Team.Name:lower()

                    if tn:find("murder") or tn:find("killer")
                        or tn:find("zombie") or tn:find("bad") then
                        roleColor = Color3.fromRGB(255, 50, 50)
                    end
                end

                local nameLbl = espGui:FindFirstChild("NameLabel")
                local hpBar = espGui:FindFirstChild("HpBg")
                    and espGui.HpBg:FindFirstChild("HpBar")
                local hl = char:FindFirstChild("ZGuiHighlight")

                if nameLbl then
                    nameLbl.Text = p.Name
                    nameLbl.TextColor3 = roleColor
                end

                if hpBar then
                    hpBar.Size = UDim2.new(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 0, 1, 0)
                end

                if hl then
                    hl.FillColor = roleColor
                    hl.OutlineColor = roleColor
                end
            else
                if char and char:FindFirstChild("ZGuiESP") then
                    char.ZGuiESP:Destroy()
                end

                if char and char:FindFirstChild("ZGuiHighlight") then
                    char.ZGuiHighlight:Destroy()
                end
            end
        end
    end
end


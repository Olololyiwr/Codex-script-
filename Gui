-- SYSTEM CROUCH INTEGRATION (TAB 2)
local crouchSystemEnabled = false
local crouchGui = nil
local touchControlsFrame = nil
local crouchButton = nil

local crouchButtonImage = "rbxassetid://109660173469064"
local crouchButtonActiveImage = "rbxassetid://139705395031155"
local crouchWalkAnimId = "rbxassetid://137525751454426"
local crouchIdleAnimId = "rbxassetid://107078800928182"

local isCrouching = false
local defaultWalkSpeed = 16
local defaultJumpPower = 50
local idleAnimIdCache, walkAnimIdCache
local crouchIdleAnimTrack, crouchWalkAnimTrack
local crouchAnimSpeed = 0.8
local crouchWalkSpeed = 5
local crouchHeartbeatConn = nil
local crouchInputBeganConn, crouchJumpReqConn, crouchInputTypeConn, crouchCharAddedConn

local function updateCrouchButtonVisibility()
    if crouchButton then
        crouchButton.Visible =
            crouchSystemEnabled
            and (UserInputService:GetLastInputType() == Enum.UserInputType.Touch)
    end
end

local function cacheCrouchAnimations()
    local char = LocalPlayer.Character
    if not char then return end

    local animate = char:FindFirstChild("Animate")
    if not animate then return end

    if not idleAnimIdCache then
        local idleAnim = animate:FindFirstChild("idle")

        if idleAnim then
            local anim = idleAnim:FindFirstChild("Animation1")
            if anim then idleAnimIdCache = anim.AnimationId end
        end
    end

    if not walkAnimIdCache then
        local walkAnim = animate:FindFirstChild("walk")

        if walkAnim then
            local anim = walkAnim:FindFirstChild("WalkAnim")
            if anim then walkAnimIdCache = anim.AnimationId end
        end
    end
end

local function deactivateCrouchState()
    if not isCrouching then return end

    local char = LocalPlayer.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    isCrouching = false

    if crouchButton then
        crouchButton.Image = crouchButtonImage
    end

    if crouchIdleAnimTrack then crouchIdleAnimTrack:Stop() end
    if crouchWalkAnimTrack then crouchWalkAnimTrack:Stop() end

    humanoid.WalkSpeed = defaultWalkSpeed
    humanoid.JumpPower = defaultJumpPower

    local animate = char:FindFirstChild("Animate")

    if animate then
        if idleAnimIdCache then
            local idle = animate:FindFirstChild("idle")

            if idle then
                local anim = idle:FindFirstChild("Animation1")
                if anim then anim.AnimationId = idleAnimIdCache end
            end
        end

        if walkAnimIdCache then
            local walk = animate:FindFirstChild("walk")

            if walk then
                local anim = walk:FindFirstChild("WalkAnim")
                if anim then anim.AnimationId = walkAnimIdCache end
            end
        end
    end

    local jumpBtn = PlayerGui:FindFirstChild("JumpButton", true)
    if jumpBtn then jumpBtn.Visible = true end
end

local function activateCrouchState()
    if isCrouching then return end

    local char = LocalPlayer.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    isCrouching = true

    if crouchButton then
        crouchButton.Image = crouchButtonActiveImage
    end

    cacheCrouchAnimations()

    defaultWalkSpeed = humanoid.WalkSpeed
    defaultJumpPower = humanoid.JumpPower

    local idleAnimation = Instance.new("Animation")
    idleAnimation.AnimationId = crouchIdleAnimId

    local walkAnimation = Instance.new("Animation")
    walkAnimation.AnimationId = crouchWalkAnimId

    crouchIdleAnimTrack = humanoid:LoadAnimation(idleAnimation)
    crouchWalkAnimTrack = humanoid:LoadAnimation(walkAnimation)
    crouchWalkAnimTrack:AdjustSpeed(crouchAnimSpeed)
    crouchWalkAnimTrack:Play()

    humanoid.JumpPower = 0

    if crouchHeartbeatConn then
        crouchHeartbeatConn:Disconnect()
    end

    crouchHeartbeatConn = RunService.Heartbeat:Connect(function()
        if not isCrouching or humanoid.Health <= 0 then
            if crouchHeartbeatConn then
                crouchHeartbeatConn:Disconnect()
            end
            return
        end

        local isMoving = humanoid.MoveDirection.Magnitude > 0

        if isMoving then
            humanoid.WalkSpeed = crouchWalkSpeed

            if crouchWalkAnimTrack and crouchWalkAnimTrack.IsPlaying then
                crouchWalkAnimTrack:Stop()
            end

            if crouchIdleAnimTrack and not crouchIdleAnimTrack.IsPlaying then
                crouchIdleAnimTrack:Play()
            end
        else
            humanoid.WalkSpeed = crouchWalkSpeed

            if crouchIdleAnimTrack and crouchIdleAnimTrack.IsPlaying then
                crouchIdleAnimTrack:Stop()
            end

            if crouchWalkAnimTrack and not crouchWalkAnimTrack.IsPlaying then
                crouchWalkAnimTrack:Play()
            end
        end

        if humanoid:GetState() == Enum.HumanoidStateType.Jumping then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)

    local jumpBtn = PlayerGui:FindFirstChild("JumpButton", true)
    if jumpBtn then jumpBtn.Visible = false end
end

local function toggleCrouchState()
    if isCrouching then
        deactivateCrouchState()
    else
        activateCrouchState()
    end
end

local function initCrouchGui()
    if crouchGui then crouchGui:Destroy() end

    crouchGui = Instance.new("ScreenGui")
    crouchGui.Name = "ZGuiCrouchGui"
    crouchGui.ResetOnSpawn = false
    crouchGui.Parent = PlayerGui

    touchControlsFrame = Instance.new("Frame", crouchGui)
    touchControlsFrame.Size = UDim2.new(1, 0, 1, 0)
    touchControlsFrame.BackgroundTransparency = 1

    local jumpButton = PlayerGui:FindFirstChild("JumpButton", true)

    if not jumpButton then
        for _, obj in ipairs(PlayerGui:GetDescendants()) do
            if obj:IsA("ImageButton")
                and (obj.Name == "JumpButton" or string.find(string.lower(obj.Name), "jump")) then
                jumpButton = obj
                break
            end
        end
    end

    crouchButton = Instance.new("ImageButton", touchControlsFrame)
    crouchButton.Name = "CrouchButton"
    crouchButton.BackgroundTransparency = 1
    crouchButton.Image = crouchButtonImage

    if jumpButton then
        crouchButton.Size = jumpButton.Size
        crouchButton.Position = UDim2.new(
            0,
            jumpButton.AbsolutePosition.X - jumpButton.AbsoluteSize.X - 10,
            0,
            jumpButton.AbsolutePosition.Y
        )
    else
        crouchButton.Size = UDim2.new(0, 60, 0, 60)
        crouchButton.Position = UDim2.new(0, 30, 1, -150)
    end

    crouchButton.MouseButton1Click:Connect(toggleCrouchState)
    updateCrouchButtonVisibility()
end

makeToggle(Tab2C, "Crouch Mode 👣 (Bò/Ngồi)", 7, function(st)
    crouchSystemEnabled = st

    if crouchSystemEnabled then
        initCrouchGui()

        if LocalPlayer.Character then
            cacheCrouchAnimations()
        end

        crouchInputBeganConn = UserInputService.InputBegan:Connect(function(input, processed)
            if processed or not crouchSystemEnabled then return end

            if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.C then
                toggleCrouchState()
            end
        end)

        crouchJumpReqConn = UserInputService.JumpRequest:Connect(function()
            if crouchSystemEnabled and isCrouching then return end
        end)

        crouchInputTypeConn = UserInputService.LastInputTypeChanged:Connect(updateCrouchButtonVisibility)

        crouchCharAddedConn = LocalPlayer.CharacterAdded:Connect(function(char)
            isCrouching = false

            if crouchButton then
                crouchButton.Image = crouchButtonImage
            end

            idleAnimIdCache = nil
            walkAnimIdCache = nil

            char:WaitForChild("Humanoid")
            cacheCrouchAnimations()

            local jumpBtn = PlayerGui:FindFirstChild("JumpButton", true)
            if jumpBtn then jumpBtn.Visible = true end

            task.delay(0.5, updateCrouchButtonVisibility)
        end)
    else
        deactivateCrouchState()

        if crouchGui then
            crouchGui:Destroy()
            crouchGui = nil
        end

        if crouchInputBeganConn then crouchInputBeganConn:Disconnect() end
        if crouchJumpReqConn then crouchJumpReqConn:Disconnect() end
        if crouchInputTypeConn then crouchInputTypeConn:Disconnect() end
        if crouchCharAddedConn then crouchCharAddedConn:Disconnect() end
    end
end)


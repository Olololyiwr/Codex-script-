-- 1. GOD MODE
local godModeEnabled = false
local godHealthConnection
local godCharacterConnection
local godDisabledScripts = {}

local function disconnectGodHealth()
    if godHealthConnection then
        godHealthConnection:Disconnect()
        godHealthConnection = nil
    end
end

local function restoreGodScripts()
    for scriptObject, previousState in pairs(godDisabledScripts) do
        pcall(function()
            if scriptObject and scriptObject.Parent then
                scriptObject.Disabled = previousState
            end
        end)
    end

    table.clear(godDisabledScripts)
end

local function disableGodDamageScripts(character)
    if not character then return end

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Script") or child:IsA("LocalScript") then
            local scriptName = child.Name:lower()

            if scriptName == "falldamage"
                or scriptName == "ragdoll"
                or scriptName:find("damage") then

                if godDisabledScripts[child] == nil then
                    local success, previousState = pcall(function()
                        return child.Disabled
                    end)

                    if success then
                        godDisabledScripts[child] = previousState

                        pcall(function()
                            child.Disabled = true
                        end)
                    end
                end
            end
        end
    end
end

local function enableGodMode()
    if not godModeEnabled then return end

    disconnectGodHealth()

    local character = LocalPlayer.Character
    if not character then return end

    disableGodDamageScripts(character)

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    godHealthConnection = humanoid.HealthChanged:Connect(function(health)
        if godModeEnabled and health < humanoid.MaxHealth then
            pcall(function()
                humanoid.Health = humanoid.MaxHealth
            end)
        end
    end)

    pcall(function()
        humanoid.Health = humanoid.MaxHealth
    end)
end

local function disableGodMode()
    godModeEnabled = false
    disconnectGodHealth()
    restoreGodScripts()
end

godCharacterConnection = LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)

    if godModeEnabled then
        enableGodMode()
    end
end)

makeToggle(Tab1C, "🛡️ God Mode", 1, function(state)
    godModeEnabled = state

    if state then
        enableGodMode()
    else
        disableGodMode()
    end
end)

-- 2. FLY MODE
local IDLE_ANIM_ID = "rbxassetid://77529400769588"
local MOVE_ANIM_ID = "rbxassetid://132105268936736"

local flySpeed = 80
local isFlying = false
local flyConnection
local flyBodyVel, flyBodyGyro
local idleTrack, moveTrack

local function cleanupFly()
    isFlying = false
    AnimationState.FlyActive = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if flyBodyVel then
        flyBodyVel:Destroy()
        flyBodyVel = nil
    end

    if flyBodyGyro then
        flyBodyGyro:Destroy()
        flyBodyGyro = nil
    end

    if idleTrack then
        idleTrack:Stop()
        idleTrack:Destroy()
        idleTrack = nil
    end

    if moveTrack then
        moveTrack:Stop()
        moveTrack:Destroy()
        moveTrack = nil
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.PlatformStand = false
    end
end

makeToggle(Tab1C, "🐦 Fly Mode", 2, function(state)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not character or not root or not humanoid then
        return
    end

    if not state then
        cleanupFly()
        return
    end

    if isFlying then return end

    isFlying = true
    AnimationState.FlyActive = true

    local camera = Workspace.CurrentCamera
    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid

    local idleAnimation = Instance.new("Animation")
    idleAnimation.AnimationId = IDLE_ANIM_ID

    local moveAnimation = Instance.new("Animation")
    moveAnimation.AnimationId = MOVE_ANIM_ID

    idleTrack = animator:LoadAnimation(idleAnimation)
    moveTrack = animator:LoadAnimation(moveAnimation)

    idleAnimation:Destroy()
    moveAnimation:Destroy()

    idleTrack.Priority = Enum.AnimationPriority.Action
    moveTrack.Priority = Enum.AnimationPriority.Action
    idleTrack.Looped = true
    moveTrack.Looped = true

    flyBodyVel = Instance.new("BodyVelocity")
    flyBodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBodyVel.Velocity = Vector3.zero
    flyBodyVel.Parent = root

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyBodyGyro.P = 10000
    flyBodyGyro.CFrame = camera.CFrame
    flyBodyGyro.Parent = root

    humanoid.PlatformStand = true
    idleTrack:Play()

    flyConnection = RunService.RenderStepped:Connect(function()
        if not isFlying or not character.Parent or humanoid.Health <= 0 then
            cleanupFly()
            return
        end

        local moveVector = Vector3.zero

        pcall(function()
            local controls = require(
                LocalPlayer.PlayerScripts.PlayerModule
            ):GetControls()

            moveVector = controls:GetMoveVector()
        end)

        if moveVector.Magnitude > 0.01 then
            if not moveTrack.IsPlaying then
                idleTrack:Stop()
                moveTrack:Play()
            end

            local camCFrame = camera.CFrame

            local flyDirection =
                (camCFrame.RightVector * moveVector.X)
                + (camCFrame.LookVector * -moveVector.Z)

            flyBodyVel.Velocity = flyDirection * flySpeed
            flyBodyGyro.CFrame = CFrame.lookAt(
                root.Position,
                root.Position + flyDirection
            )
        else
            if not idleTrack.IsPlaying then
                moveTrack:Stop()
                idleTrack:Play()
            end

            flyBodyVel.Velocity = Vector3.zero
            flyBodyGyro.CFrame = camera.CFrame
        end
    end)
end)


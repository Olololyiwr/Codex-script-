local IDLE_ANIM_ID = "rbxassetid://77529400769588"
local MOVE_ANIM_ID = "rbxassetid://132105268936736"

local flySpeed = 80
local isFlying = false
local flyConnection = nil
local flyBodyVel, flyBodyGyro = nil, nil
local idleTrack, moveTrack = nil, nil

local function cleanupFly()
    isFlying = false

    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if flyBodyVel then flyBodyVel:Destroy() flyBodyVel = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    if idleTrack then idleTrack:Stop() idleTrack = nil end
    if moveTrack then moveTrack:Stop() moveTrack = nil end

    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        char:FindFirstChildOfClass("Humanoid").PlatformStand = false
    end
end

makeToggle(Tab1C, "🐦 Fly Mode", 2, function(st)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart")
        or not char:FindFirstChildOfClass("Humanoid") then
        return
    end

    if not st then
        cleanupFly()
    else
        isFlying = true

        local hrp = char.HumanoidRootPart
        local hum = char:FindFirstChildOfClass("Humanoid")
        local camera = Workspace.CurrentCamera
        local animator = hum:FindFirstChildOfClass("Animator") or hum

        local idleAnim = Instance.new("Animation")
        idleAnim.AnimationId = IDLE_ANIM_ID

        local moveAnim = Instance.new("Animation")
        moveAnim.AnimationId = MOVE_ANIM_ID

        idleTrack = animator:LoadAnimation(idleAnim)
        moveTrack = animator:LoadAnimation(moveAnim)

        flyBodyVel = Instance.new("BodyVelocity")
        flyBodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        flyBodyVel.Velocity = Vector3.zero
        flyBodyVel.Parent = hrp

        flyBodyGyro = Instance.new("BodyGyro")
        flyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        flyBodyGyro.P = 10000
        flyBodyGyro.CFrame = camera.CFrame
        flyBodyGyro.Parent = hrp

        hum.PlatformStand = true
        idleTrack:Play()

        flyConnection = RunService.RenderStepped:Connect(function()
            if not isFlying or not char or hum.Health <= 0 then
                cleanupFly()
                return
            end

            local moveVector = Vector3.zero

            pcall(function()
                local controls = require(LocalPlayer.PlayerScripts.PlayerModule):GetControls()
                moveVector = controls:GetMoveVector()
            end)

            if moveVector.Magnitude > 0.01 then
                if not moveTrack.IsPlaying then
                    idleTrack:Stop()
                    moveTrack:Play()
                end

                local camCFrame = camera.CFrame
                local flyDir =
                    (camCFrame.RightVector * moveVector.X)
                    + (camCFrame.LookVector * -moveVector.Z)

                flyBodyVel.Velocity = flyDir * flySpeed
                flyBodyGyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flyDir)
            else
                if not idleTrack.IsPlaying then
                    moveTrack:Stop()
                    idleTrack:Play()
                end

                flyBodyVel.Velocity = Vector3.zero
                flyBodyGyro.CFrame = camera.CFrame
            end
        end)
    end
end)


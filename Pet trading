local function makeTab(name,label)
    local button = new("TextButton",{
        Size=UDim2.new(.25,-5,1,0),
        BackgroundColor3=name == CurrentTab and ORANGE or CARD,
        Text=label,
        TextColor3=WHITE,
        Font=Enum.Font.GothamBold,
        TextSize=10,
        BorderSizePixel=0,
        AutoButtonColor=false
    },Nav)
    corner(button,8)

    button.Activated:Connect(function()
        CurrentTab = name
        Search.Text = ""

        for _,item in ipairs(Nav:GetChildren()) do
            if item:IsA("TextButton") then
                tween(item,TweenInfo.new(.15),{
                    BackgroundColor3=item == button and ORANGE or CARD
                })
            end
        end

        render()
    end)
end


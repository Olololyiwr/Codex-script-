local function applyPetNameEffect(label,category)
    local colors = category == "Colored" and ColoredGradient or RainbowGradient

    label.TextColor3 = WHITE
    label.TextStrokeColor3 = Color3.fromRGB(15,15,20)
    label.TextStrokeTransparency = .25

    local gradient = new("UIGradient",{
        Color=colors,
        Rotation=0,
        Offset=Vector2.new(-1,0)
    },label)

    local duration = category == "Rainbow" and 5 or 4

    TweenService:Create(
        gradient,
        TweenInfo.new(duration,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,-1,true),
        {Offset=Vector2.new(1,0)}
    ):Play()

    new("UIStroke",{
        Color=category == "Colored"
            and Color3.fromRGB(160,80,255)
            or Color3.fromRGB(80,180,255),
        Thickness=.8,
        Transparency=.55
    },label)
end


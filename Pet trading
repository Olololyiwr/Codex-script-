    local function sendSellRequest(id,amount)
        if not SellRemote then
            return false,"Sell remote not found"
        end

        local before = getCount(id)

        if before <= 0 then
            return false,"Pet count is zero"
        end

        amount = math.min(amount,before)

        local ok,err = pcall(function()
            SellRemote:FireServer("sell",id,amount)

            -- The second event is only sent when this pet is currently held.
            if getHeldPet() == tostring(id) and PickAndDropRemote then
                PickAndDropRemote:FireServer("Sell")
            end
        end)

        if not ok then
            return false,tostring(err)
        end

        -- Verify by checking whether inventory count actually decreases.
        local deadline = os.clock()+3

        repeat
            task.wait(.15)

            local after = getCount(id)
            if after < before then
                return true,"Sold"
            end
        until os.clock() >= deadline

        return false,"No inventory change detected"
    end


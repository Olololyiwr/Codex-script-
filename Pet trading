-- COMPACT TAB BUTTONS

local TabButtons = {}

local function makeTab(name,label)
    local button = new("TextButton",{
        Size=UDim2.new(1,0,0,34),
        BackgroundColor3=name == CurrentTab and ORANGE or CARD,
        Text=label,
        TextColor3=WHITE,
        Font=Enum.Font.GothamBold,
        TextSize=9,
        BorderSizePixel=0,
        AutoButtonColor=false
    },Nav)

    corner(button,8)
    stroke(button,ORANGE,name == CurrentTab and 1.2 or .7,.65)

    TabButtons[name] = button

    button.Activated:Connect(function()
        CurrentTab = name
        Search.Text = ""

        for tabName,item in pairs(TabButtons) do
            local active = tabName == CurrentTab

            tween(item,TweenInfo.new(.15),{
                BackgroundColor3=active and ORANGE or CARD
            })
        end

        render()
    end)
end


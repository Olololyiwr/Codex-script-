        Text="Select pets you want to sell",
        TextColor3=MUTED,
        Font=Enum.Font.Gotham,
        TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left
    },SellPanel)

    local PetList = new("ScrollingFrame",{
        Position=UDim2.new(0,10,0,60),
        Size=UDim2.new(1,-20,0,255),
        BackgroundColor3=PANEL,
        BorderSizePixel=0,
        ScrollBarThickness=3,
        ScrollBarImageColor3=ORANGE,
        AutomaticCanvasSize=Enum.AutomaticSize.Y,
        CanvasSize=UDim2.new()
    },SellPanel)
    corner(PetList,8)

    local ListLayout = new("UIListLayout",{
        Padding=UDim.new(0,5),
        SortOrder=Enum.SortOrder.LayoutOrder
    },PetList)

    new("UIPadding",{
        PaddingTop=UDim.new(0,6),
        PaddingLeft=UDim.new(0,6),
        PaddingRight=UDim.new(0,6),
        PaddingBottom=UDim.new(0,6)
    },PetList)

    local selectedPets = {}
    local sellBusy = false

    local function refreshPetList()
        for _,v in ipairs(PetList:GetChildren()) do
            if v:IsA("TextButton") then
                v:Destroy()
            end
        end

        if not Inventory then return end

        local found = 0

        for _,item in ipairs(Inventory:GetChildren()) do
            local id = tonumber(item.Name)

            if id then
                local count = getCount(id)

                if count > 0 then
                    found += 1

                    local nameLabel = item:FindFirstChild("NameLabel",true)
                    local petName = nameLabel and nameLabel.Text or ("Pet "..id)

                    local isSelected = selectedPets[id] == true

                    local row = new("TextButton",{
                        Size=UDim2.new(1,-4,0,37),
                        BackgroundColor3=isSelected
                            and Color3.fromRGB(75,48,30)
                            or CARD,
                        Text="",
                        BorderSizePixel=0,
                        AutoButtonColor=false
                    },PetList)
                    corner(row,7)

                    new("TextLabel",{
                        Position=UDim2.new(0,8,0,0),
                        Size=UDim2.new(1,-85,1,0),
                        BackgroundTransparency=1,
                        Text=(isSelected and "☑ " or "□ ")..petName,
                        TextColor3=WHITE,
                        Font=Enum.Font.Gotham,
                        TextSize=11,
                        TextXAlignment=Enum.TextXAlignment.Left
                    },row)

                    new("TextLabel",{
                        Position=UDim2.new(1,-75,0,0),
                        Size=UDim2.fromOffset(67,37),
                        BackgroundTransparency=1,
                        Text="x"..count,
                        TextColor3=ORANGE,
                        Font=Enum.Font.GothamBold,
                        TextSize=12
                    },row)

                    row.Activated:Connect(function()
                        if selectedPets[id] then
                            selectedPets[id] = nil
                        else
                            selectedPets[id] = true
                        end

                        refreshPetList()
                    end)
                else
                    selectedPets[id] = nil
                end
            end
        end

        Info.Text = found.." pet types found"
    end

    local SellSelected = new("TextButton",{
        Position=UDim2.new(0,10,0,328),
        Size=UDim2.new(1,-20,0,42),
        BackgroundColor3=Color3.fromRGB(45,145,80),
        Text="SELL SELECTED",
        TextColor3=WHITE,
        Font=Enum.Font.GothamBold,
        TextSize=13,
        BorderSizePixel=0
    },SellPanel)
    corner(SellSelected,9)

    SellSelected.Activated:Connect(function()
        if sellBusy then return end

        if not SellRemote or not PickAndDropRemote then
            Info.Text = "Sell remote not found"
            return
        end

        local batch = {}

        for id in pairs(selectedPets) do
            local count = getCount(id)

            if count > 0 then
                table.insert(batch,{
                    id=id,
                    amount=count
                })
            end
        end

        if #batch == 0 then
            Info.Text = "Select at least one pet"
            return
        end

        sellBusy = true
        SellSelected.Active = false
        SellSelected.Text = "SELLING..."

        task.spawn(function()
            local success = 0

            for _,pet in ipairs(batch) do
                if not SellPanel.Parent then break end

                local currentCount = getCount(pet.id)
                local amount = math.min(currentCount,pet.amount)

                if amount > 0 then
                    local ok = pcall(function()
                        SellRemote:FireServer(
                            "sell",
                            pet.id,
                            amount
                        )

                        PickAndDropRemote:FireServer("Sell")
                    end)

                    if ok then
                        success += 1
                    end

                    task.wait(0.25)
                end
            end

            table.clear(selectedPets)

            Info.Text = "Sale requests sent: "..success.."/"..#batch

            task.wait(0.5)
            refreshPetList()

            SellSelected.Text = "SELL SELECTED"
            SellSelected.Active = true
            sellBusy = false
        end)
    end)

    local RefreshButton = new("TextButton",{
        Position=UDim2.new(0,10,0,370),
        Size=UDim2.new(1,-20,0,1),
        BackgroundTransparency=1,
        Text="",
        Visible=false
    },SellPanel)

    task.spawn(function()
        while SellPanel.Parent do
            refreshPetList()
            task.wait(1)
        end
    end)

    -- Keep the selected pet and inventory display updated.

    task.spawn(function()
        while SellPanel.Parent do
            local held = getHeldPet()

            if held then
                sellSelectedId = held
                sellSelectedName = getPetName(held)

                SellPetLabel.Text =
                    "Selected: "..sellSelectedName.." ["..held.."]"

                local count = getCount(held)
                SellCountLabel.Text = "Inventory: x"..tostring(count)

                if not pendingSellId and not sellBusy then
                    setSellStatus("Ready to sell")
                end
            else
                sellSelectedId = nil
                sellSelectedName = nil

                SellPetLabel.Text = "Waiting for pet selection..."
                SellCountLabel.Text = "Inventory: --"

                if not pendingSellId and not sellBusy then
                    setSellStatus("Hold a pet to select it")
                end
            end

            task.wait(.2)
        end
    end)

    -- ORIGINAL CREDITS BUTTON

    makeActionButton(
        scroll,
        "Credits ⭐",
        "Original script by olololyiwr",
        function()
            CurrentTab = "Credits"
            Search.Text = ""
            render()
        end
    )

    new("TextLabel",{
        Size=UDim2.new(1,0,0,40),
        BackgroundTransparency=1,
        Text="Choose Colored or Rainbow to browse pets.",
        TextColor3=MUTED,
        Font=Enum.Font.Gotham,
        TextSize=11
    },scroll)
end

-- PET LIST

local function showPets(pets,category)
    clearContent()
    Search.Visible = true

    local scroll = createList()
    local query = string.lower(Search.Text or "")
    local count = 0

    for _,pet in ipairs(pets) do
        local name,id = pet[1],pet[2]

        if query == ""
            or string.find(string.lower(name),query,1,true)
            or string.find(tostring(id),query,1,true) then

            count += 1

            makeActionButton(
                scroll,
                name,
                "ID: "..id.."  •  "..category,
                function()
                    local ok,err = pcall(function()
                        ReplicatedStorage:WaitForChild("Events")
                            :WaitForChild("Coin")
                            :WaitForChild("CoinMarketRE")
                            :FireServer("purchase",id,1)
                    end)

                    if not ok then
                        warn("[Pet Hub] Purchase error:",err)
                    end
                end,
                category
            )
        end
    end

    if count == 0 then
        new("TextLabel",{
            Size=UDim2.new(1,0,0,45),
            BackgroundTransparency=1,
            Text="No pets found.",
            TextColor3=MUTED,
            Font=Enum.Font.Gotham,
            TextSize=14
        },scroll)
    end
end


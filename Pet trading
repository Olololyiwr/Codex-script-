    local function stopDrop(message)
        dropRunning = false
        if message then setDropStatus(message) end
    end

    Stop.Activated:Connect(function()
        stopDrop("Stopped")
    end)

    task.spawn(function()
        while DropPanel.Parent do
            if not dropRunning then
                local id = getHeldPet()

                if id then
                    selectedPetId = id
                    selectedPetName = getPetName(id)
                    PetLabel.Text = "Selected: "..selectedPetName.." ["..id.."]"
                    setDropStatus("Ready to start")
                else
                    selectedPetId = nil
                    selectedPetName = nil
                    PetLabel.Text = "Waiting for pet selection..."
                    setDropStatus("Select a pet from inventory")
                end
            end

            task.wait(.2)
        end
    end)

    Start.Activated:Connect(function()
        if dropRunning then return end

        if not AutoDropRemote or not Inventory then
            setDropStatus("Game inventory/remote not found")
            return
        end

        local amount = tonumber(Quantity.Text)

        if not amount or amount < 1 or amount%1 ~= 0 then
            setDropStatus("Invalid quantity")
            return
        end

        local held = getHeldPet()

        if not held or held ~= selectedPetId then
            setDropStatus("Take a pet first!")
            return
        end

        dropTarget = amount
        dropInitialCount = getCount(held)

        if dropInitialCount < 1 then
            setDropStatus("Pet not found in inventory")
            return
        end

        if amount > dropInitialCount then
            setDropStatus("Not enough pets")
            return
        end

        dropRunning = true
        setDropStatus("Dropping 0/"..dropTarget)

        task.spawn(function()
            local lastProgress = -1

            while dropRunning do
                local progress = getDropProgress()

                if progress ~= lastProgress then
                    lastProgress = progress
                    setDropStatus("Dropped "..progress.."/"..dropTarget)
                end

                if progress >= dropTarget then
                    stopDrop("Completed!")
                    break
                end

                local currentHeld = getHeldPet()

                if not currentHeld then
                    if getCount(selectedPetId) <= 0 then
                        stopDrop("No more pets")
                        break
                    end

                    AutoDropRemote:FireServer(
                        "TakeTool",
                        tonumber(selectedPetId)
                    )

                    local deadline = os.clock()+4

                    repeat
                        task.wait(.08)
                        currentHeld = getHeldPet()
                    until currentHeld == selectedPetId
                        or os.clock() >= deadline
                        or not dropRunning

                    if not dropRunning then break end

                    if currentHeld ~= selectedPetId then
                        stopDrop("Take pet timeout")
                        break
                    end

                elseif currentHeld == selectedPetId then
                    local before = getCount(selectedPetId)

                    AutoDropRemote:FireServer("Drop")

                    local deadline = os.clock()+4
                    local countChanged = false

                    repeat
                        task.wait(.08)

                        if getCount(selectedPetId) < before then
                            countChanged = true
                            break
                        end
                    until os.clock() >= deadline or not dropRunning

                    if not dropRunning then break end

                    if not countChanged then
                        setDropStatus("Waiting for inventory update...")
                        task.wait(.25)
                    end
                else
                    stopDrop("Different pet detected")
                    break
                end

                task.wait(.12)
            end

            if dropRunning then
                dropRunning = false
            end

            if getDropProgress() >= dropTarget then
                setDropStatus("Completed!")
            end
        end)
    end)


        if not amount or amount < 1 or amount%1 ~= 0 then
            setStatus("Invalid quantity")
            return
        end

        local held = getHeldPet()
        if not held or held ~= selectedPetId then
            setStatus("Take a pet first!")
            return
        end

        dropTarget = amount
        dropInitialCount = getCount(held)

        if dropInitialCount < 1 then
            setStatus("Pet not found in inventory")
            return
        end

        if amount > dropInitialCount then
            setStatus("Not enough pets")
            return
        end

        dropRunning = true
        setStatus("Dropping 0/"..dropTarget)

        task.spawn(function()
            local lastProgress = -1

            while dropRunning do
                local progress = getDropProgress()

                if progress ~= lastProgress then
                    lastProgress = progress
                    setStatus("Dropped "..progress.."/"..dropTarget)
                end

                if progress >= dropTarget then
                    stopDrop("Completed!")
                    break
                end

                local currentHeld = getHeldPet()

                if not currentHeld then
                    if getCount(selectedPetId) <= 0 then
                        stopDrop("No more pets")
                        break
                    end

                    AutoDropRemote:FireServer(
                        "TakeTool",
                        tonumber(selectedPetId)
                    )

                    local deadline = os.clock()+4
                    repeat
                        task.wait(.08)
                        currentHeld = getHeldPet()
                    until currentHeld == selectedPetId
                        or os.clock() >= deadline
                        or not dropRunning

                    if not dropRunning then break end

                    if currentHeld ~= selectedPetId then
                        stopDrop("Take pet timeout")
                        break
                    end
                elseif currentHeld == selectedPetId then
                    local before = getCount(selectedPetId)

                    AutoDropRemote:FireServer("Drop")

                    local deadline = os.clock()+4
                    local countChanged = false

                    repeat
                        task.wait(.08)

                        local nowCount = getCount(selectedPetId)
                        if nowCount < before then
                            countChanged = true
                            break
                        end
                    until os.clock() >= deadline or not dropRunning

                    if not dropRunning then break end

                    if not countChanged then
                        setStatus("Waiting for inventory update...")
                        task.wait(.25)
                    end
                else
                    stopDrop("Different pet detected")
                    break
                end

                task.wait(.12)
            end

            if dropRunning then dropRunning = false end

            if getDropProgress() >= dropTarget then
                setStatus("Completed!")
            end
        end)
    end)
      
      

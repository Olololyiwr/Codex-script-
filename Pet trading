local function readObjectText(obj)
    local ok,value = pcall(function()
        return obj.Text
    end)

    if ok and value ~= nil then
        return tostring(value)
    end

    return nil
end

local function parseCount(text)
    if not text then return nil end

    local cleaned = tostring(text):gsub(",","")
    local number = cleaned:match("[xX]%s*(%d+)")
        or cleaned:match("(%d+)%s*[xX]")

    return tonumber(number)
end

local function getCount(id)
    if not Inventory or not id then return 0 end

    local item = Inventory:FindFirstChild(tostring(id))
    if not item then return 0 end

    -- Check common count values and labels first.
    for _,obj in ipairs(item:GetDescendants()) do
        local lowerName = string.lower(obj.Name)

        if lowerName == "itemcount"
            or lowerName == "count"
            or lowerName == "amount"
            or lowerName == "quantity" then

            local text = readObjectText(obj)
            local number = parseCount(text)

            if number then return number end

            local ok,value = pcall(function()
                return obj.Value
            end)

            if ok and tonumber(value) then
                return tonumber(value)
            end
        end
    end

    -- Check attributes used by some inventory interfaces.
    for _,attribute in ipairs({"ItemCount","Count","Amount","Quantity"}) do
        local value = item:GetAttribute(attribute)
        if tonumber(value) then
            return tonumber(value)
        end
    end

    -- Last fallback: only accept text that looks like a quantity.
    for _,obj in ipairs(item:GetDescendants()) do
        local text = readObjectText(obj)
        local number = parseCount(text)

        if number and number > 0 then
            return number
        end
    end

    return 0
end

local function getPetName(id)
    if not Inventory then return "Pet "..tostring(id) end

    local item = Inventory:FindFirstChild(tostring(id))
    if not item then return "Pet "..tostring(id) end

    for _,name in ipairs({"NameLabel","PetName","DisplayName","ItemName"}) do
        local label = item:FindFirstChild(name,true)
        local text = label and readObjectText(label)

        if text and text ~= "" and not tonumber(text) then
            return text
        end
    end

    for _,obj in ipairs(item:GetDescendants()) do
        local text = readObjectText(obj)

        if text and text ~= ""
            and not tonumber(text)
            and not parseCount(text)
            and string.lower(obj.Name) ~= "itemcount" then
            return text
        end
    end

    return "Pet "..tostring(id)
end

local function getHeldPet()
    local char = Player.Character
    if not char then return nil end

    for _,obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") and tonumber(obj.Name) then
            return obj.Name
        end
    end
end

local dropRunning = false
local selectedPetId = nil
local selectedPetName = nil
local dropInitialCount = 0
local dropTarget = 0

local function getDropProgress()
    if not selectedPetId then return 0 end

    local current = getCount(selectedPetId)
    return math.max(0,dropInitialCount-current)
end

-- ADIDAS ANIMATION

local AnimationIds = {
    Idle = "rbxassetid://122257458498464",
    Walk = "rbxassetid://122150855457006",
    Run = "rbxassetid://82598234841035",
    Jump = "rbxassetid://75290611992385",
    Fall = "rbxassetid://98600215928904"
}

local animationConnections = {}
local animationSpeed = 1.12

local function applyAdidas(character)
    if not character then return end

    task.spawn(function()
        local animate = character:WaitForChild("Animate",10)
        if not animate then return end

        for _,obj in ipairs(animate:GetDescendants()) do
            if obj:IsA("Animation") then
                local n = string.lower(obj.Name)

                if n == "idle" or n == "animation1" or n == "animation2" then
                    if obj.Parent and string.lower(obj.Parent.Name) == "idle" then
                        obj.AnimationId = AnimationIds.Idle
                    end
                elseif n == "walkanim" then
                    obj.AnimationId = AnimationIds.Walk
                elseif n == "runanim" then
                    obj.AnimationId = AnimationIds.Run
                elseif n == "jumpanim" then
                    obj.AnimationId = AnimationIds.Jump
                elseif n == "fallanim" then
                    obj.AnimationId = AnimationIds.Fall
                end
            end
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if animationConnections[character] then
                animationConnections[character]:Disconnect()
            end

            animationConnections[character] = humanoid.AnimationPlayed:Connect(function(track)
                task.defer(function()
                    if track and track.IsPlaying then
                        pcall(function()
                            track:AdjustSpeed(animationSpeed)
                        end)
                    end
                end)
            end)
        end
    end)
end

if Player.Character then
    applyAdidas(Player.Character)
end


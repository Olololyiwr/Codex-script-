    local query = string.lower(Search.Text or "")
    local count = 0

    for _,pet in ipairs(pets) do
        local name,id = pet[1],pet[2]

        if query == ""
            or string.find(string.lower(name),query,1,true)
            or string.find(tostring(id),query,1,true) then

            count += 1

            makeActionButton(
                scroll,
                name,
                "ID: "..id.."  •  "..category,
                function()
                    local ok,err = pcall(function()
                        ReplicatedStorage:WaitForChild("Events")
                            :WaitForChild("Coin")
                            :WaitForChild("CoinMarketRE")
                            :FireServer("purchase",id,1)
                    end)

                    if not ok then
                        warn("[Pet Hub] Purchase error:",err)
                    end
                end,
                category
            )
        end
    end

    if count == 0 then
        new("TextLabel",{
            Size=UDim2.new(1,0,0,45),
            BackgroundTransparency=1,
            Text="No pets found.",
            TextColor3=MUTED,
            Font=Enum.Font.Gotham,
            TextSize=13
        },scroll)
    end
end


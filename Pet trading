    local function waitForHeldPet(id,timeout)
        local deadline = os.clock()+(timeout or 4)

        repeat
            if not dropRunning then return false end
            if getHeldPet() == tostring(id) then return true end
            task.wait(.05)
        until os.clock() >= deadline

        return getHeldPet() == tostring(id)
    end

    local function waitForInventoryDecrease(id,before,timeout)
        local deadline = os.clock()+(timeout or 4)

        repeat
            if not dropRunning then return false end

            if getCount(id) < before then
                return true
            end

            task.wait(.05)
        until os.clock() >= deadline

        return getCount(id) < before
    end

    DropStart.Activated:Connect(function()
        if dropRunning then return end

        if not AutoDropRemote or not Inventory then
            setDropStatus("Inventory / Remote not found")
            return
        end

        if not selectedPetId then
            setDropStatus("Choose a pet first")
            return
        end

        local amount = tonumber(DropQuantityBox.Text)

        if not amount or amount < 1 or amount%1 ~= 0 then
            setDropStatus("Invalid quantity")
            return
        end

        local initial = getCount(selectedPetId)

        if initial <= 0 then
            setDropStatus("No pet in inventory")
            updateDropCount()
            return
        end

        if amount > initial then
            setDropStatus("Quantity exceeds inventory")
            updateDropCount()
            return
        end

        dropInitialCount = initial
        dropTarget = amount
        dropRunning = true
        dropBusy = true

        DropStart.Text = "DROPPING..."
        DropStart.BackgroundColor3 = Color3.fromRGB(190,105,35)
        setDropStatus("ULTRA DROP running")
        DropProgress.Text = "0 / "..dropTarget

        task.spawn(function()
            local lastShown = -1

            while dropRunning do
                local progress = getDropProgress()

                if progress ~= lastShown then
                    lastShown = progress
                    DropProgress.Text = progress.." / "..dropTarget
                end

                if progress >= dropTarget then
                    setDropStatus("Completed!")
                    break
                end

                local held = getHeldPet()

                if held and held ~= selectedPetId then
                    setDropStatus("Another pet is equipped")
                    break
                end

                if not held then
                    if getCount(selectedPetId) <= 0 then
                        setDropStatus("No more pets")
                        break
                    end

                    AutoDropRemote:FireServer(
                        "TakeTool",
                        tonumber(selectedPetId)
                    )

                    if not waitForHeldPet(selectedPetId,4) then
                        if dropRunning then
                            setDropStatus("Take pet timeout")
                        end
                        break
                    end
                else
                    local before = getCount(selectedPetId)

                    if before <= 0 then
                        setDropStatus("No more pets")
                        break
                    end

                    AutoDropRemote:FireServer("Drop")

                    -- Wait for the server-confirmed inventory change.
                    -- No repeated Drop request while the previous one is pending.
                    if not waitForInventoryDecrease(selectedPetId,before,4) then
                        if dropRunning then
                            setDropStatus("Server did not confirm drop")
                        end
                        break
                    end
                end
            end

            local completed = getDropProgress() >= dropTarget

            dropRunning = false
            dropBusy = false

            DropStart.Text = "ULTRA DROP"
            DropStart.BackgroundColor3 = ORANGE

            if completed then
                setDropStatus("Completed!")
            elseif DropStatus.Text == "ULTRA DROP running" then
                setDropStatus("Stopped")
            end

            DropProgress.Text = getDropProgress().." / "..dropTarget
            updateDropCount()
        end)
    end)

